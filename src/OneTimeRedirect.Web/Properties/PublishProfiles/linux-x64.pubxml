<Project>
  <!-- dotnet publish src/OneTimeRedirect.Web -p:PublishProfile=linux-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Framework-dependent: runtime security fixes arrive with apt (aspnetcore-runtime-10.0). -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\deploy\publish\</PublishDir>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
